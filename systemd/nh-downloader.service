[Unit]
Description=nh-project LAN downloader HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linus
Group=wheel
Environment=HOME=/home/linus
WorkingDirectory=/home/linus/nh-project
ExecStart=/usr/bin/python3 /home/linus/nh-project/server/nh_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
